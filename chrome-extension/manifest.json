{
  "manifest_version": 3,
  "name": "PrepPilot AI Integrity Companion",
  "version": "1.0",
  "description": "Optional companion extension to enhance coding session integrity.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://*.preppilot.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "https://*.preppilot.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
