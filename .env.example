# ==========================================
# Frontend Environment Variables
# ==========================================

# API and Auth
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Firebase (Core Database & Auth Integration)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Supabase (Used exclusively for Resume & Video Blob Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...

# ==========================================
# Backend Environment Variables
# ==========================================

# Server Config
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
ALLOWED_ORIGINS=https://preppilot-pi-sandy.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
SHUTDOWN_TIMEOUT_MS=10000

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_...

# Groq / LLM Configuration (Primary)
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI / LLM Configuration (Optional Secondary Fallback)
OPENAI_API_KEY=sk_...
OPENAI_MODEL=gpt-4o-mini

# AI Concurrency & Overload Control (Optional process-local limits)
AI_MAX_CONCURRENT_REQUESTS=10
AI_MAX_CONCURRENT_PER_USER=3
AI_CONCURRENCY_QUEUE_MAX_SIZE=10
AI_CONCURRENCY_QUEUE_TIMEOUT_MS=3000

# AI Model Cost Accounting (Optional JSON overrides, per 1M tokens)
# AI_MODEL_PRICING_JSON='{"custom/model":{"promptCostPerMillion":1.0,"completionCostPerMillion":3.0}}'

# Deepgram (Speech-to-Text)
DEEPGRAM_API_KEY=...
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en-US

# TTS Provider (e.g. elevenlabs)
TTS_PROVIDER=elevenlabs
TTS_API_KEY=...
TTS_VOICE_ID=pNInz6obpgDQGcFmaJgB
TTS_MODEL=eleven_turbo_v2

# Firebase Admin (Service Account for Backend operations)
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
